import os
import json
import pandas as pd
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
from google import generativeai as genai
from pathlib import Path

# --- 初始化配置 ---
genai.configure(api_key="YOUR_GEMINI_API_KEY")
model = genai.GenerativeModel('gemini-3-flash')

app = FastAPI(title="Discovery Sub-Agent Service")

class DiscoveryRequest(BaseModel):
    source_path: str
    output_path: str
    schema_path: str

@app.post("/discover")
async def run_discovery(request: DiscoveryRequest):
    source_dir = Path(request.source_path)
    output_dir = Path(request.output_path)
    schema_path = Path(request.schema_path)

    if not source_dir.exists():
        raise HTTPException(status_code=404, detail="Source path not found")

    # 1. 加载 Schema 作为推理上下文
    try:
        with open(schema_path, 'r', encoding='utf-8') as f:
            schema_context = json.load(f)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to load schema: {str(e)}")

    output_dir.mkdir(parents=True, exist_ok=True)
    processed_assets = []

    # 2. 扫描并处理文件
    for file in source_dir.iterdir():
        if file.suffix.lower() in ['.pdf', '.pptx', '.docx']:
            try:
                # 上传至 Gemini File API
                uploaded_file = genai.upload_file(path=str(file))
                
                prompt = f"""
                You are a Discovery Sub-Agent. 
                Task: Extract asset metadata from the attached file based on this Schema:
                {json.dumps(schema_context)}
                
                Output: Return ONLY a valid JSON array of objects. 
                If no assets found, return [].
                """
                
                response = model.generate_content([prompt, uploaded_file])
                
                # 清洗 Markdown 代码块标签
                raw_json = response.text.replace('```json', '').replace('
```', '').strip()
                extracted_data = json.loads(raw_json)

                # 保存到本地作为持久化备份
                save_path = output_dir / f"{file.stem}_extracted.json"
                with open(save_path, 'w', encoding='utf-8') as f:
                    json.dump(extracted_data, f, indent=2, ensure_ascii=False)

                processed_assets.append({
                    "original_file": file.name,
                    "extracted_count": len(extracted_data),
                    "data": extracted_data
                })
            except Exception as e:
                print(f"Error processing {file.name}: {e}")

    return {
        "status": "completed",
        "agent": "Discovery_Sub_Agent_v1",
        "results": processed_assets
    }

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8001)
