from flask import Flask, request, jsonify
import os

app = Flask(__name__)

@app.route('/a2a/tasks/send', methods=['POST'])
def scan_path():
    data = request.json
    # Expected param: root_path
    path = data.get('params', {}).get('root_path', '')
    valid_exts = ('.pdf', '.ppt', '.pptx', '.docx', '.txt', '.json')
    manifest = []
    
    if os.path.exists(path):
        for root, _, files in os.walk(path):
            for f in files:
                if f.lower().endswith(valid_exts):
                    manifest.append({
                        "file_name": f, 
                        "file_path": os.path.join(root, f)
                    })
    
    return jsonify({
        "jsonrpc": "2.0", 
        "result": manifest, 
        "id": data.get('id')
    })

if __name__ == "__main__":
    app.run(port=8081)


from flask import Flask, request, jsonify
import json
import os
from google import genai

app = Flask(__name__)

os.environ["GOOGLE_API_KEY"] = "YOUR_API_KEY"
client = genai.Client(api_key=os.getenv("GOOGLE_API_KEY"))
MODEL_ID = "gemini-2.5-flash"

PROMPT_FILE = "/Users/Andy.Li/Asset_Strategy/Asset Harvesting/3_asset_harvest_prompt.md"
SCHEMA_FILE = "/Users/Andy.Li/Asset_Strategy/Asset Harvesting/1_schema.json"

# Mandatory value mapping to prevent numeric-only returns
VALUE_MAP = {
    "Monetized": {"1": "1 - Yes (licensed)", "2": "2 - No (consulting asset)"},  
    "Category": {"1": "1 - Paper", "2": "2 - Solution Component", "3": "3 - Full Solution"},  
