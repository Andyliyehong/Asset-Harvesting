from flask import Flask, request, jsonify
import os

app = Flask(__name__)

@app.route('/a2a/tasks/send', methods=['POST'])
def scan_path():
    data = request.json
    # Expected param: root_path
    path = data.get('params', {}).get('root_path', '')
    valid_exts = ('.pdf', '.ppt', '.pptx', '.docx', '.txt', '.json')
    manifest = []
    
    if os.path.exists(path):
        for root, _, files in os.walk(path):
            for f in files:
                if f.lower().endswith(valid_exts):
                    manifest.append({
                        "file_name": f, 
                        "file_path": os.path.join(root, f)
                    })
    
    return jsonify({
        "jsonrpc": "2.0", 
        "result": manifest, 
        "id": data.get('id')
    })

if __name__ == "__main__":
    app.run(port=8081)
