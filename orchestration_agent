import mesop as me
import httpx
from dataclasses import field

# --- 1. Global State ---
@me.stateclass
class State:
    sub_agents: list[dict] = field(default_factory=list)
    new_agent_name: str = ""
    new_agent_port: str = ""
    chat_history: list[dict] = field(default_factory=list)
    chat_input: str = ""
    is_loading: bool = False

# --- 2. Event Handlers ---

def on_name_input(e: me.InputEvent):
    me.state(State).new_agent_name = e.value

def on_port_input(e: me.InputEvent):
    me.state(State).new_agent_port = e.value

def on_chat_input(e: me.InputEvent):
    me.state(State).chat_input = e.value

def add_agent(e: me.ClickEvent):
    state = me.state(State)
    if state.new_agent_name and state.new_agent_port:
        state.sub_agents.append({
            "name": state.new_agent_name, 
            "port": str(state.new_agent_port).strip()
        })
        state.new_agent_name = ""
        state.new_agent_port = ""

async def send_message(e: me.ClickEvent):
    state = me.state(State)
    user_val = state.chat_input.strip()
    if not user_val:
        return
    
    state.chat_history.append({"role": "user", "content": user_val})
    state.chat_input = ""
    state.is_loading = True

    bot_res = ""
    if "discover" in user_val.lower():
        target_path = user_val.split("discover")[-1].strip()
        agent_8081 = next((a for a in state.sub_agents if a['port'] == '8081'), None)
        
        if not agent_8081:
            bot_res = "Orchestrator Error: No Discovery Agent found on Port 8081."
        else:
            try:
                async with httpx.AsyncClient() as client:
                    response = await client.post(
                        "http://localhost:8081/a2a/tasks/send",
                        json={"params": {"path": target_path}},
                        timeout=15.0
                    )
                    
                    if response.status_code == 200:
                        data = response.json()
                        result = data.get("result", {})
                        if isinstance(result, dict) and result.get("status") == "Found":
                            bot_res = f"Discovery Successful!\nFile: {result.get('file_name')}\nContent: {result.get('content', '')[:100]}..."
                        else:
                            bot_res = f"Agent Feedback: {result.get('status', 'Not found')}"
                    else:
                        bot_res = f"Sub-agent Error: HTTP {response.status_code}"
            except Exception as ex:
                bot_res = f"Pipeline Failed: {str(ex)}"
    else:
        bot_res = "System: Use 'discover [path]' to trigger the pipeline."

    state.chat_history.append({"role": "bot", "content": bot_res})
    state.is_loading = False

# --- 3. UI Layout ---

@me.page(path="/")
def app():
    state = me.state(State)
    
    with me.box(style=me.Style(display="flex", height="100vh", font_family="Inter, sans-serif")):
        
        # Sidebar
        with me.box(style=me.Style(
            width="300px", 
            padding=me.Padding.all(20), 
            background="#f4f4f4",
            border=me.Border.all(me.BorderSide(width=1, color="#ddd", style="solid"))
        )):
            me.text("System Registry", type="headline-6")
            me.input(label="Agent Role", value=state.new_agent_name, on_input=on_name_input)
            me.input(label="Port", value=state.new_agent_port, on_input=on_port_input)
            me.button("Register Agent", on_click=add_agent, type="flat", style=me.Style(margin=me.Margin(top=10)))
            
            # Use specific top/bottom instead of 'vertical' keyword
            me.divider(style=me.Style(margin=me.Margin(top=20, bottom=20)))
            
            me.text("Pipeline Nodes:", style=me.Style(font_weight="bold", margin=me.Margin(bottom=10)))
            for agent in state.sub_agents:
                with me.box(style=me.Style(padding=me.Padding.all(8), background="#fff", margin=me.Margin(bottom=5))):
                    me.text(f"{agent['name']} (Port: {agent['port']})", style=me.Style(font_size=12))

        # Chat Panel
        with me.box(style=me.Style(flex_grow=1, display="flex", flex_direction="column")):
            with me.box(style=me.Style(padding=me.Padding.all(15), border_bottom=me.Border.all(me.BorderSide(width=1, color="#eee")))):
                me.text("AI Agent Orchestrator", type="headline-5")

            with me.box(style=me.Style(flex_grow=1, padding=me.Padding.all(20), overflow_y="scroll")):
                for m in state.chat_history:
                    is_user = m['role'] == "user"
                    with me.box(style=me.Style(
                        margin=me.Margin(bottom=15),
                        padding=me.Padding.all(12),
                        border_radius=8,
                        background="#e1f5fe" if is_user else "#eeeeee",
                        align_self="flex-end" if is_user else "flex-start",
                        max_width="75%"
                    )):
                        me.text(m['content'])

            with me.box(style=me.Style(padding=me.Padding.all(20), display="flex", gap=10, border_top=me.Border.all(me.BorderSide(width=1, color="#eee")))):
                me.input(
                    label="Command Entry", 
                    value=state.chat_input, 
                    on_input=on_chat_input, 
                    style=me.Style(flex_grow=1)
                )
                me.button(
                    "Execute", 
                    on_click=send_message, 
                    disabled=state.is_loading, 
                    type="raised"
                )
