import mesop as me
import httpx
from dataclasses import field

# --- 1. Global State ---
@me.stateclass
class State:
    # Python 3.9+ lowercase type hinting
    sub_agents: list[dict] = field(default_factory=list)
    new_agent_name: str = ""
    new_agent_port: str = ""
    chat_history: list[dict] = field(default_factory=list)
    chat_input: str = ""
    is_loading: bool = False

# --- 2. Event Handlers ---

def on_name_blur(e: me.InputEvent):
    me.state(State).new_agent_name = e.value

def on_port_blur(e: me.InputEvent):
    me.state(State).new_agent_port = e.value

def on_chat_blur(e: me.InputEvent):
    me.state(State).chat_input = e.value

def add_agent(e: me.ClickEvent):
    state = me.state(State)
    if state.new_agent_name and state.new_agent_port:
        state.sub_agents.append({
            "name": state.new_agent_name, 
            "port": state.new_agent_port
        })
        state.new_agent_name = ""
        state.new_agent_port = ""

async def send_message(e: me.ClickEvent):
    state = me.state(State)
    user_val = state.chat_input
    if not user_val:
        return
    
    state.chat_history.append({"role": "user", "content": user_val})
    state.chat_input = ""
    state.is_loading = True

    bot_res = ""
    if "discover" in user_val.lower():
        target_path = user_val.split("discover")[-1].strip()
        # Find the agent registered on 8081
        discovery_agent = next((a for a in state.sub_agents if a['port'] == '8081'), None)
        
        if not discovery_agent:
            bot_res = "Error: Discovery Agent not found on Port 8081."
        else:
            try:
                async with httpx.AsyncClient() as client:
                    resp = await client.post(
                        "http://localhost:8081/a2a/tasks/send",
                        json={"params": {"path": target_path}},
                        timeout=10.0
                    )
                    data = resp.json()
                    res = data.get("result", {})
                    if res and res.get("status") == "Found":
                        bot_res = f"Success: {res.get('file_name')}. Content: {res.get('content')[:100]}..."
                    else:
                        bot_res = f"Status: {res.get('status', 'Not Found or Error')}"
            except Exception as ex:
                bot_res = f"Network Connection Error: {str(ex)}"
    else:
        bot_res = "System: Use 'discover [file_path]' to test the sub-agent."

    state.chat_history.append({"role": "bot", "content": bot_res})
    state.is_loading = False

# --- 3. UI Layout ---

@me.page(path="/")
def app():
    state = me.state(State)
    
    with me.box(style=me.Style(display="flex", height="100vh", font_family="Inter, sans-serif")):
        
        # Sidebar Container
        with me.box(style=me.Style(
            width="320px", 
            padding=me.Padding.all(24), 
            background="#f8f9fa",
            # Standard border syntax for Mesop
            border=me.Border.all(me.BorderSide(width=1, color="#ddd", style="solid"))
        )):
            me.text("Sub-Agent Manager", type="headline-6")
            
            with me.box(style=me.Style(margin=me.Margin(top=16))):
                me.input(label="Agent Name", on_blur=on_name_input)
                me.input(label="Port", on_blur=on_port_blur)
                me.button("Register", on_click=add_agent, type="flat")
            
            me.divider(style=me.Style(margin=me.Margin(vertical=20)))
            
            me.text("Active Cluster:", style=me.Style(font_weight="bold"))
            for agent in state.sub_agents:
                with me.box(style=me.Style(padding=me.Padding.all(8), margin=me.Margin(top=5), background="#fff")):
                    me.text(f"{agent['name']} @ {agent['port']}")

        # Chatbot Interface
        with me.box(style=me.Style(flex_grow=1, display="flex", flex_direction="column")):
            
            # Chat History
            with me.box(style=me.Style(flex_grow=1, padding=me.Padding.all(24), overflow_y="scroll")):
                for m in state.chat_history:
                    is_user = m['role'] == "user"
                    with me.box(style=me.Style(
                        margin=me.Margin(bottom=12),
                        padding=me.Padding.all(12),
                        background="#e3f2fd" if is_user else "#f1f1f1",
                        border_radius=8,
                        align_self="flex-end" if is_user else "flex-start"
                    )):
                        me.text(m['content'])

            # Footer Input
            with me.box(style=me.Style(padding=me.Padding.all(24), display="flex", gap=12)):
                me.input(label="Chat / Command", on_blur=on_chat_blur, value=state.chat_input, style=me.Style(flex_grow=1))
                me.button("Run", on_click=send_message, disabled=state.is_loading, type="raised")
